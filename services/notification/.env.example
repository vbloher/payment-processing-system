LOGGER_PRETTY_CONSOLE=true
LOGGER_LEVEL=info

HTTP_PORT=8082

POSTGRES_USER=login
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_DB_NAME=notification

NATS_URL=nats://localhost:4222

NATS_CONSUMER_DURABLE=notification
NATS_CONSUMER_MAX_DELIVER=5
NATS_CONSUMER_RETRY_DELAY=1s
NATS_CONSUMER_ACK_WAIT=30s

# Empty: notifications are only logged.
NOTIFICATION_WEBHOOK_URL=
# Must be above 0 and below 4/5 of NATS_CONSUMER_ACK_WAIT, the consumer's handler timeout.
NOTIFICATION_WEBHOOK_TIMEOUT=5s

OTEL_ENDPOINT=
OTEL_SERVICE_NAME=notification
OTEL_NAMESPACE=
OTEL_INSTANCE_ID=
OTEL_RATIO=1.0
